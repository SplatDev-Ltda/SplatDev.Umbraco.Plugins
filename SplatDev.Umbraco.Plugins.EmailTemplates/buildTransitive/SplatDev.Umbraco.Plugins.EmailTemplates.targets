<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsEmailTemplatesContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsEmailTemplatesContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsEmailTemplatesAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsEmailTemplatesContentFiles Include="$(SplatDevUmbracoPluginsEmailTemplatesContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsEmailTemplatesContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsEmailTemplatesContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
