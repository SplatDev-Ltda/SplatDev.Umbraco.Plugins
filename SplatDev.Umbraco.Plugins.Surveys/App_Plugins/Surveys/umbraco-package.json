{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Surveys",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "UmbracoCms.Surveys.Dashboard",
      "name": "Surveys Dashboard",
      "element": "/App_Plugins/Surveys/dist/surveys-dashboard.element.js",
      "elementName": "surveys-dashboard",
      "weight": 100,
      "meta": {
        "label": "Surveys",
        "pathname": "surveys"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.SurveysPicker",
      "name": "Survey",
      "element": "/App_Plugins/Surveys/dist/surveys-picker.element.js",
      "elementName": "surveys-picker",
      "meta": {
        "label": "Survey",
        "icon": "icon-list",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Umbraco.Integer"
      }
    }
  ]
}
