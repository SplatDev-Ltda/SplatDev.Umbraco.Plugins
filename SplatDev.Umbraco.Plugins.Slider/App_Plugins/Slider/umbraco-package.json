{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Slider",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "Slider.Dashboard",
      "name": "Slider",
      "element": "/App_Plugins/Slider/dist/slider-dashboard.element.js",
      "elementName": "slider-dashboard",
      "weight": 100,
      "meta": {
        "label": "Slider",
        "pathname": "slider"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.SliderPicker",
      "name": "Slider",
      "element": "/App_Plugins/Slider/dist/slider-picker.element.js",
      "elementName": "slider-picker",
      "meta": {
        "label": "Slider",
        "icon": "icon-slideshow",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Umbraco.Integer"
      }
    }
  ]
}
