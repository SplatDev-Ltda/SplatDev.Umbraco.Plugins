{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Video Preview",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "videoPreview.dashboard",
      "name": "Video Preview Dashboard",
      "element": "/App_Plugins/VideoPreview/dist/dashboard.js",
      "weight": -99,
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ],
      "meta": {
        "pathname": "video-preview",
        "label": "Video Preview"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.VideoPreview",
      "name": "Video Preview",
      "element": "/App_Plugins/VideoPreview/dist/videopreview-property-editor.element.js",
      "elementName": "videopreview-property-editor",
      "meta": {
        "label": "Video Preview",
        "icon": "icon-movie",
        "group": "Rich Content",
        "propertyEditorSchemaAlias": "Umbraco.TextBox"
      }
    },
    {
      "type": "localization",
      "alias": "SplatDev.Localization.VideoPreview.pt-br",
      "name": "VideoPreview (pt-br)",
      "meta": {
        "culture": "pt-br"
      },
      "value": {
        "videoPreview": {
          "paste": "Cole o endereço do vídeo",
          "noPreview": "Nenhuma prévia disponível"
        }
      }
    }
  ]
}
