{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Video Preview",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "videoPreview.dashboard",
      "name": "Video Preview Dashboard",
      "element": "/App_Plugins/VideoPreview/dist/dashboard.js",
      "weight": -99,
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ],
      "meta": {
        "pathname": "video-preview",
        "label": "Video Preview"
      }
    },
    {
      "type": "propertyEditorSchema",
      "alias": "SplatDev.VideoPreview",
      "name": "Video Preview",
      "meta": {
        "defaultPropertyEditorUiAlias": "SplatDev.PropertyEditorUi.VideoPreview"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.VideoPreview",
      "name": "Video Preview",
      "element": "/App_Plugins/VideoPreview/dist/videopreview-property-editor.element.js",
      "elementName": "videopreview-property-editor",
      "meta": {
        "label": "Video Preview",
        "icon": "icon-video",
        "group": "media",
        "propertyEditorSchemaAlias": "SplatDev.VideoPreview"
      }
    }
  ]
}
