<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsVideoPreviewContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsVideoPreviewContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsVideoPreviewAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsVideoPreviewContentFiles Include="$(SplatDevUmbracoPluginsVideoPreviewContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsVideoPreviewContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsVideoPreviewContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
