<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsEmailNotificationsContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsEmailNotificationsContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsEmailNotificationsAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsEmailNotificationsContentFiles Include="$(SplatDevUmbracoPluginsEmailNotificationsContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsEmailNotificationsContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsEmailNotificationsContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
