{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Live Video",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "liveVideo.dashboard",
      "name": "Live Video Dashboard",
      "element": "/App_Plugins/LiveVideo/dist/dashboard.js",
      "weight": -99,
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ],
      "meta": {
        "pathname": "live-video",
        "label": "Live Video"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.LiveVideo",
      "name": "Live Video",
      "element": "/App_Plugins/LiveVideo/dist/livevideo-property-editor.element.js",
      "elementName": "livevideo-property-editor",
      "meta": {
        "label": "Live Video",
        "icon": "icon-video",
        "group": "media",
        "propertyEditorSchemaAlias": "Umbraco.TextBox"
      }
    }
  ]
}
