<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsPropertiesReportContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsPropertiesReportContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsPropertiesReportAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsPropertiesReportContentFiles Include="$(SplatDevUmbracoPluginsPropertiesReportContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsPropertiesReportContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsPropertiesReportContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
