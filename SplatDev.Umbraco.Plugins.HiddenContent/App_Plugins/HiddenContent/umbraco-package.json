{
  "$schema": "../../umbraco-package-schema.json",
  "name": "UmbracoCms.Plugins.HiddenContent",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "hiddencontent.dashboard",
      "name": "Hidden Content Dashboard",
      "element": "/App_Plugins/HiddenContent/dist/hiddencontent-dashboard.element.js",
      "elementName": "hiddencontent-dashboard",
      "weight": 100,
      "meta": {
        "label": "Hidden Content",
        "pathname": "hiddencontent"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "propertyEditorSchema",
      "alias": "SplatDev.HiddenContent",
      "name": "Hide From Navigation",
      "meta": {
        "defaultPropertyEditorUiAlias": "SplatDev.PropertyEditorUi.HiddenContent"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.HiddenContent",
      "name": "Hide From Navigation",
      "element": "/App_Plugins/HiddenContent/dist/hiddencontent-property-editor.element.js",
      "elementName": "hiddencontent-property-editor",
      "meta": {
        "label": "Hide From Navigation",
        "icon": "icon-eye-off",
        "group": "common",
        "propertyEditorSchemaAlias": "SplatDev.HiddenContent"
      }
    }
  ]
}
