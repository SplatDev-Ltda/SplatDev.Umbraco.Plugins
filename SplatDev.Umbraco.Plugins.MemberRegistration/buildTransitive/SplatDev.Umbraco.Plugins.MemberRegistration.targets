<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsMemberRegistrationContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsMemberRegistrationContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsMemberRegistrationAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsMemberRegistrationContentFiles Include="$(SplatDevUmbracoPluginsMemberRegistrationContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsMemberRegistrationContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsMemberRegistrationContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
