<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SplatDev.Umbraco.Themes.Forum</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.4</Version>
    <Authors>SplatDev</Authors>
    <Description>Forum/community theme for Umbraco - thread list, post view, user profiles, categories</Description>
    <PackageTags>umbraco;theme;forum;community umbraco-marketplace</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Company>SplatDev Ltda</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</PackageProjectUrl>
    <RepositoryUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Core" Version="13.12.0" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="13.12.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="13.12.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Core" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SplatDev.Umbraco.Plugins.Yaml\SplatDev.Umbraco.Plugins.Yaml2Schema\SplatDev.Umbraco.Plugins.Yaml2Schema.csproj" />
    <ProjectReference Include="..\SplatDev.Umbraco.Themes.Base\SplatDev.Umbraco.Themes.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Config\umbraco.yml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Views\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
