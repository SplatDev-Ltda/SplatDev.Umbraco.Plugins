<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ContentTargetFolders>.</ContentTargetFolders>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>SplatDev.Umbraco.Plugins.Analytics</PackageId>
    <Version>2.1.5</Version>
    <Authors>SplatDev</Authors>
    <Description>Compatibility shim for the renamed Google Analytics GA4 package. Install SplatDev.Umbraco.Plugins.GoogleAnalytics directly for new applications.</Description>
    <PackageTags>umbraco analytics google-analytics ga4 deprecated</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SplatDev.Umbraco.Plugins.GoogleAnalytics/SplatDev.Umbraco.Plugins.GoogleAnalytics.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Pack backoffice assets at their App_Plugins paths; embedded resources alone are not deployed by PackageReference. -->
  <ItemGroup>
    <Content Include="App_Plugins\**\*" Pack="true" PackagePath="App_Plugins" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
