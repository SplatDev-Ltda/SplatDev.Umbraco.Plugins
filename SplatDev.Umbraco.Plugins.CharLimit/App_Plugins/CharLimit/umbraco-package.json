{
  "$schema": "../../umbraco-package-schema.json",
  "name": "CharLimit",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "propertyEditorSchema",
      "alias": "UmbracoCms.CharLimit",
      "name": "Character Limit",
      "meta": {
        "defaultPropertyEditorUiAlias": "SplatDev.PropertyEditorUi.CharLimit"
      }
    },
    {
      "type": "dashboard",
      "alias": "CharLimit.Dashboard",
      "name": "Character Limit",
      "element": "/App_Plugins/CharLimit/charlimit-dashboard.js",
      "elementName": "charlimit-dashboard",
      "weight": 100,
      "meta": {
        "label": "Character Limit",
        "pathname": "char-limit"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.CharLimit",
      "name": "Char Limit Restrict",
      "element": "/App_Plugins/CharLimit/charlimit-property-editor.element.js",
      "elementName": "charlimit-property-editor",
      "meta": {
        "label": "Char Limit Restrict",
        "icon": "icon-stop-hand",
        "group": "Common",
        "propertyEditorSchemaAlias": "UmbracoCms.CharLimit",
        "settings": {
          "properties": [
            {
              "alias": "maxChars",
              "label": "Maximum characters",
              "description": "The limit the field enforces.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer"
            },
            {
              "alias": "showCountdown",
              "label": "Show remaining count",
              "description": "Shows how many characters are left as you type.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
            }
          ],
          "defaultData": [
            {
              "alias": "showCountdown",
              "value": true
            }
          ]
        }
      }
    },
    {
      "type": "localization",
      "alias": "SplatDev.Localization.CharLimit.en-us",
      "name": "Char Limit Restrict (en-us)",
      "meta": {
        "culture": "en-us"
      },
      "value": {
        "charLimit": {
          "youHave": "You have",
          "charactersLeft": "characters left",
          "only": "Only",
          "charactersAllowed": "characters allowed!",
          "noLimit": "No limit is set on this data type."
        }
      }
    },
    {
      "type": "localization",
      "alias": "SplatDev.Localization.CharLimit.nl-nl",
      "name": "Char Limit Restrict (nl-nl)",
      "meta": {
        "culture": "nl-nl"
      },
      "value": {
        "charLimit": {
          "youHave": "Je hebt nog",
          "charactersLeft": "karakters over",
          "only": "Niet meer dan",
          "charactersAllowed": "karakters toegestaan!",
          "noLimit": "Voor dit datatype is geen limiet ingesteld."
        }
      }
    },
    {
      "type": "localization",
      "alias": "SplatDev.Localization.CharLimit.pt-br",
      "name": "Char Limit Restrict (pt-br)",
      "meta": {
        "culture": "pt-br"
      },
      "value": {
        "charLimit": {
          "youHave": "Você tem",
          "charactersLeft": "caracteres sobrando",
          "only": "Somente",
          "charactersAllowed": "caracteres permitidos!",
          "noLimit": "Nenhum limite definido para este tipo de dados."
        }
      }
    }
  ]
}
