<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsNuGetCatalogContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsNuGetCatalogContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsNuGetCatalogAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsNuGetCatalogContentFiles Include="$(SplatDevUmbracoPluginsNuGetCatalogContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsNuGetCatalogContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsNuGetCatalogContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
