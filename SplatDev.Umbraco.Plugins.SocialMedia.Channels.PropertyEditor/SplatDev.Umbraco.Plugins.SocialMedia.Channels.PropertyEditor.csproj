<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup>
    <ContentTargetFolders>.</ContentTargetFolders><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PackageId>SplatDev.Umbraco.Plugins.SocialMedia.Channels.PropertyEditor</PackageId><Version>1.1.3</Version><PackageReadmeFile>README.md</PackageReadmeFile><PackageIcon>icon.png</PackageIcon><Authors>SplatDev</Authors><Description>Social Media Channels property editor for Umbraco 17.</Description><PackageTags>umbraco property-editor social-media umbraco-marketplace</PackageTags><PackageLicenseExpression>MIT</PackageLicenseExpression><RepositoryUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</RepositoryUrl><GenerateAssemblyInfo>false</GenerateAssemblyInfo><GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest></PropertyGroup><ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App"/><PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.6"/><PackageReference Include="Umbraco.Cms.Core" Version="17.3.4"/><PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4"/></ItemGroup><ItemGroup><EmbeddedResource Include="App_Plugins\**\*"/><None Include="README.md" Pack="true" PackagePath="\"/><None Include="icon.png" Pack="true" PackagePath="\"/><None Include="umbraco-marketplace.json" Pack="true" PackagePath="\"/></ItemGroup>
  <!-- Pack backoffice assets at their App_Plugins paths; embedded resources alone are not deployed by PackageReference. -->
  <ItemGroup>
    <!-- The icon themes are 11 MB of PNGs. They were both embedded in the assembly and
         packed as content, so every image shipped twice and the package came to 13 MB
         against 0.49 MB for the next largest — which is why NuGet held 1.1.0 in
         validation. The embedded copy is the one that serves them at runtime through the
         manifest file provider, so only the buildTransitive loose-file drop loses them. -->
    <Content Include="App_Plugins\**\*" Exclude="App_Plugins\**\themes\**" Pack="true" PackagePath="App_Plugins" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
