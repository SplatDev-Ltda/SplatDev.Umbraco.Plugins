{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Social Media Channels Property Editor",
  "version": "1.0.0",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.SocialMediaChannels.PropertyEditorUi",
      "name": "Social Media Channels Property Editor",
      "element": "/App_Plugins/SocialMediaChannels/dist/property-editor.js",
      "elementName": "splatdev-social-media-channels-property-editor",
      "meta": {
        "label": "Social Media Channels",
        "propertyEditorSchemaAlias": "Umbraco.TextBox",
        "icon": "icon-share",
        "group": "Rich Content",
        "supportsReadOnly": true
      }
    }
  ]
}
