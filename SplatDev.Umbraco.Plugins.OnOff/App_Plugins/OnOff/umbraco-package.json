{
  "$schema": "../../umbraco-package-schema.json",
  "name": "OnOff",
  "version": "2.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "UmbracoCms.OnOff.Dashboard",
      "name": "Feature Toggles Dashboard",
      "element": "/App_Plugins/OnOff/dist/onoff-dashboard.element.js",
      "elementName": "onoff-dashboard",
      "weight": 100,
      "meta": {
        "label": "Feature Toggles",
        "pathname": "feature-toggles"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "UmbracoCms.OnOff.Localization.En",
      "name": "OnOff \u2014 English",
      "meta": {
        "culture": "en",
        "localizations": {
          "section": {
            "onoff_heading": "Feature Toggles",
            "onoff_description": "Enable, disable and schedule site features",
            "onoff_features": "Features",
            "onoff_enabled": "Enabled",
            "onoff_disabled": "Disabled",
            "onoff_scheduled": "Scheduled"
          }
        }
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.OnOff",
      "name": "On/Off Switch",
      "element": "/App_Plugins/OnOff/dist/onoff-property-editor.element.js",
      "elementName": "onoff-property-editor",
      "meta": {
        "label": "On/Off Switch",
        "icon": "icon-power",
        "group": "common",
        "propertyEditorSchemaAlias": "Umbraco.TrueFalse",
        "settings": {
          "properties": [
            {
              "alias": "onText",
              "label": "On label",
              "description": "Shown when the switch is on.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextBox"
            },
            {
              "alias": "offText",
              "label": "Off label",
              "description": "Shown when the switch is off.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextBox"
            }
          ],
          "defaultData": [
            {
              "alias": "onText",
              "value": "On"
            },
            {
              "alias": "offText",
              "value": "Off"
            }
          ]
        }
      }
    }
  ]
}