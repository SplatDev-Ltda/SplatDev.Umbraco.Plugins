<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsExamineExtensionsContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsExamineExtensionsContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsExamineExtensionsAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsExamineExtensionsContentFiles Include="$(SplatDevUmbracoPluginsExamineExtensionsContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsExamineExtensionsContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsExamineExtensionsContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
