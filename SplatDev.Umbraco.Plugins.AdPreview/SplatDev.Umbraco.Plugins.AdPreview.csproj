<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SplatDev.Umbraco.Plugins.AdPreview</AssemblyName><RootNamespace>SplatDev.Umbraco.Plugins.AdPreview</RootNamespace>
    <PackageId>SplatDev.Umbraco.Plugins.AdPreview</PackageId><Version>1.0.3</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageIcon>icon.png</PackageIcon>
    <Description>Image ad preview property editor for Umbraco 13 and 17.</Description><PackageTags>umbraco;property-editor;advertising;preview;splatdev</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression><RepositoryUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</RepositoryUrl><RepositoryType>git</RepositoryType>
    <ContentTargetFolders>.</ContentTargetFolders>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'"><PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" /><PackageReference Include="Umbraco.Cms.Core" Version="13.12.0" /><PackageReference Include="Umbraco.Cms.Web.Common" Version="13.12.0" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'"><PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.6" /><PackageReference Include="Umbraco.Cms.Core" Version="17.3.4" /><PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="App_Plugins\**\*" /><None Include="README.md" Pack="true" PackagePath="\" /><None Include="icon.png" Pack="true" PackagePath="\" /><None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" /><Content Include="App_Plugins\**\*" Pack="true" PackagePath="App_Plugins" /><None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" /></ItemGroup>
</Project>
