<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsExceptionManagerContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsExceptionManagerContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsExceptionManagerAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsExceptionManagerContentFiles Include="$(SplatDevUmbracoPluginsExceptionManagerContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsExceptionManagerContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsExceptionManagerContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
