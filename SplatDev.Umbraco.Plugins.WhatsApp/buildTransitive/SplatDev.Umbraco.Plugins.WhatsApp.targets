<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Copies the plugin's App_Plugins assets into the consuming site.

    Without this the package installs the assembly and nothing else: NuGet places
    App_Plugins/ at the package root, and with PackageReference nothing copies root
    content into the consuming project. The backend would work while the backoffice
    dashboard silently failed to appear — the manifest and the Lit bundle would never
    reach wwwroot.

    Same mechanism as SplatDev.Umbraco.Plugins.CacheManager.
  -->
  <PropertyGroup>
    <SplatDevWhatsAppContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\WhatsApp\**\*.*</SplatDevWhatsAppContentFilesPath>
  </PropertyGroup>

  <Target Name="CopySplatDevWhatsAppAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevWhatsAppContentFiles Include="$(SplatDevWhatsAppContentFilesPath)" />
    </ItemGroup>
    <Message Text="Copying SplatDev.Umbraco.Plugins.WhatsApp assets: @(SplatDevWhatsAppContentFiles->Count()) file(s)" Importance="high" />
    <Copy SourceFiles="@(SplatDevWhatsAppContentFiles)"
          DestinationFiles="@(SplatDevWhatsAppContentFiles->'$(MSBuildProjectDirectory)\App_Plugins\WhatsApp\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ClearSplatDevWhatsAppAssets" BeforeTargets="Clean">
    <ItemGroup>
      <SplatDevWhatsAppDir Include="$(MSBuildProjectDirectory)\App_Plugins\WhatsApp\" />
    </ItemGroup>
    <Message Text="Clearing old SplatDev.Umbraco.Plugins.WhatsApp assets" Importance="high" />
    <RemoveDir Directories="@(SplatDevWhatsAppDir)" />
  </Target>
</Project>
