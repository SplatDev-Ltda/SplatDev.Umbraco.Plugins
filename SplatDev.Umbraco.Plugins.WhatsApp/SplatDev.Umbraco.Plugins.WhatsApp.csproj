<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ContentTargetFolders>.</ContentTargetFolders>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <PackageId>SplatDev.Umbraco.Plugins.WhatsApp</PackageId>
    <Product>SplatDev.Umbraco.Plugins.WhatsApp</Product>
    <Title>SplatDev.Umbraco.Plugins.WhatsApp</Title>
    <Version>3.5.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>SplatDev</Authors>
    <Description>WhatsApp Business Cloud API integration for Umbraco — backoffice inbox, template and free-form sending, and an inbound webhook receiver. Supports Umbraco 13 (net8.0) and Umbraco 17 (net10.0); the Lit 3 dashboard requires Umbraco 17.</Description>
    <PackageTags>umbraco umbraco-marketplace whatsapp messaging cloud-api business</PackageTags>
    <Company>SplatDev Ltda</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</PackageProjectUrl>
    <RepositoryUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>
    <!-- Pure helpers (window arithmetic, recipient normalisation, template variable
         counting) are internal by design but are exactly the logic worth unit testing. -->
    <InternalsVisibleTo Include="SplatDev.Umbraco.Plugins.WhatsApp.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Core" Version="13.12.0" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="13.12.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="13.12.0" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
    <!-- ManifestEmbeddedFileProvider + the GenerateEmbeddedFilesManifest target -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Core" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- ManifestEmbeddedFileProvider + the GenerateEmbeddedFilesManifest target -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- App_Plugins is embedded in the assembly and served at runtime by a
         ManifestEmbeddedFileProvider (see WhatsAppComposer). Nothing is copied into
         the consuming site, so there are no loose files to drift or clean up, and the
         package cannot install "half working" the way a content-copy can. -->
    <EmbeddedResource Include="App_Plugins\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <!-- NuGet and the Umbraco Marketplace both show this; without it the listing gets a grey placeholder. -->
    <None Include="docs\brand\icon.png" Pack="true" PackagePath="\" />
    <None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" Condition="Exists('umbraco-marketplace.json')" />
  </ItemGroup>

  <!-- Pack backoffice assets at their App_Plugins paths; embedded resources alone are not deployed by PackageReference. -->
  <ItemGroup>
    <Content Include="App_Plugins\**\*" Pack="true" PackagePath="App_Plugins" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
