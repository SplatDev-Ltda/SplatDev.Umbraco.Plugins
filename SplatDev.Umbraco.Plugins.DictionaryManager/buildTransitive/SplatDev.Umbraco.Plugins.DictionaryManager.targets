<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsDictionaryManagerContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsDictionaryManagerContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsDictionaryManagerAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsDictionaryManagerContentFiles Include="$(SplatDevUmbracoPluginsDictionaryManagerContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsDictionaryManagerContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsDictionaryManagerContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
