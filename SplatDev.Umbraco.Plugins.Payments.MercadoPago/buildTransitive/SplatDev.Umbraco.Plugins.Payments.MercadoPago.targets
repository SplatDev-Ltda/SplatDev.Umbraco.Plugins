<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsPaymentsMercadoPagoContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsPaymentsMercadoPagoContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsPaymentsMercadoPagoAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsPaymentsMercadoPagoContentFiles Include="$(SplatDevUmbracoPluginsPaymentsMercadoPagoContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsPaymentsMercadoPagoContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsPaymentsMercadoPagoContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
