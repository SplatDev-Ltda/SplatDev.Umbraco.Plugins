{
  "$schema": "../../umbraco-package-schema.json",
  "name": "PhotoGallery",
  "version": "2.0.1",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "PhotoGallery.Dashboard",
      "name": "Photo Gallery",
      "element": "/App_Plugins/PhotoGallery/dist/photogallery-dashboard.element.js",
      "elementName": "photogallery-dashboard",
      "weight": 100,
      "meta": {
        "label": "Photo Gallery",
        "pathname": "photo-gallery"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.PropertyEditorUi.PhotoGalleryPicker",
      "name": "Album",
      "element": "/App_Plugins/PhotoGallery/dist/photogallery-picker.element.js",
      "elementName": "photogallery-picker",
      "meta": {
        "label": "Album",
        "icon": "icon-pictures",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Umbraco.Integer"
      }
    }
  ]
}
