# Misc
*.cache
# git has core.ignorecase=true here, so the rule above also matches the
# SplatDev.Cache project directory and silently ignores anything new added to it
# (its icon.png needed -f). Keep the project tracked.
!/SplatDev.Cache/
!/SplatDev.Cache/**
# ...but not its build output. The two lines above re-include everything under that
# project, which defeated the bin/ and obj/ rules above and let `git add -A` commit 77
# build artefacts.
/SplatDev.Cache/**/bin/
/SplatDev.Cache/**/obj/
*.log
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.tlh
*.tli
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
ipch/
artifacts/

