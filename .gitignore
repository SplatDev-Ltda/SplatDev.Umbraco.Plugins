# ============================================================

Credentials.md

# ============================================================
# VS Code
# ============================================================

.vscode/
**/.vscode/

# ============================================================
# .bin folders
# ============================================================

.bin/
**/.bin/

# WhatsApp plugin: local client build artefacts
SplatDev.Umbraco.Plugins.WhatsApp/client/node_modules/

# Playwright MCP session artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Playwright screenshots captured into the repo root
wa-*.png

# node_modules is symlinked between plugin clients by build-all-plugins.sh to save
# disk. A trailing-slash pattern does not match a symlink, so 59 of them were tracked as
# links into an absolute path on one developer machine.
**/client/node_modules

# The Umbraco 17 baseline is a local test site: its database, generated Views, config and
# umbraco/ runtime folder are per-machine state, not source. `git add -A` swept its live
# SQLite files into a commit once; these keep that from repeating.
test-environments/*/umbraco/
test-environments/*/Views/
test-environments/*/config/
test-environments/**/*.sqlite.db
test-environments/**/*.db-shm
test-environments/**/*.db-wal

# Python bytecode. tools/*.py are run directly and by CI; importing one for a test
# leaves a __pycache__ beside it, and a plain `git add -A` then commits it. Two .pyc
# files reached master that way, one of them in the commit that fixed the unlist
# planner.
__pycache__/
*.py[cod]
