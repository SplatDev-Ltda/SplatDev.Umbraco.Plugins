<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- PdfCurator.Core / PdfCurator.Web (private, published by splatdevtech/pdf-curator CI).
         Credentials come from the environment: GITHUB_ACTOR + GITHUB_TOKEN (packages:read). -->
    <add key="github-splatdevtech" value="https://nuget.pkg.github.com/splatdevtech/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-splatdevtech>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-splatdevtech>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-splatdevtech">
      <package pattern="PdfCurator.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
