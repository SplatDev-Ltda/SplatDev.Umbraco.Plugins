<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy packaged backoffice assets into the consuming Umbraco application's App_Plugins folder. -->
  <PropertyGroup>
    <SplatDevUmbracoPluginsSocialMediaChannelsContentFilesPath>$(MSBuildThisFileDirectory)..\App_Plugins\**\*.*</SplatDevUmbracoPluginsSocialMediaChannelsContentFilesPath>
  </PropertyGroup>
  <Target Name="CopySplatDevUmbracoPluginsSocialMediaChannelsAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SplatDevUmbracoPluginsSocialMediaChannelsContentFiles Include="$(SplatDevUmbracoPluginsSocialMediaChannelsContentFilesPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(SplatDevUmbracoPluginsSocialMediaChannelsContentFiles)" DestinationFiles="@(SplatDevUmbracoPluginsSocialMediaChannelsContentFiles-&gt;'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
