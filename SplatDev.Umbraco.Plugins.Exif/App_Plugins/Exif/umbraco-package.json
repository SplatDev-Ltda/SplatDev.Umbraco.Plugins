{
  "$schema": "../../umbraco-package-schema.json",
  "name": "EXIF Viewer",
  "version": "1.0.1",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "exif.dashboard",
      "name": "EXIF Metadata Dashboard",
      "element": "/App_Plugins/Exif/dist/exif-dashboard.element.js",
      "elementName": "exif-dashboard",
      "weight": -10,
      "meta": {
        "label": "EXIF Viewer",
        "pathname": "exif-viewer"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "workspaceView",
      "alias": "exif.mediaView",
      "name": "EXIF",
      "js": "/App_Plugins/Exif/dist/exif-media-view.element.js",
      "elementName": "exif-media-view",
      "weight": 50,
      "meta": {
        "label": "EXIF",
        "pathname": "exif",
        "icon": "icon-camera"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Media"
        }
      ]
    }
  ]
}
