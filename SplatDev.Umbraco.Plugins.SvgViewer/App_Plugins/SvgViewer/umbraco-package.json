{
  "$schema": "../../umbraco-package-schema.json",
  "name": "SVG Viewer",
  "version": "1.0.0",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "svgViewer.dashboard",
      "name": "SVG Viewer Dashboard",
      "element": "/App_Plugins/SvgViewer/dist/svg-viewer-dashboard.js",
      "elementName": "svg-viewer-dashboard",
      "weight": -10,
      "meta": {
        "label": "SVG Viewer",
        "pathname": "svg-viewer"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "SplatDev.SvgViewer.PropertyEditorUi",
      "name": "SVG Viewer Property Editor UI",
      "element": "/App_Plugins/SvgViewer/dist/svg-viewer-property-editor.js",
      "elementName": "svg-viewer-property-editor",
      "meta": {
        "label": "Custom SVG Viewer",
        "propertyEditorSchemaAlias": "Umbraco.TextBox",
        "icon": "icon-umb-media",
        "group": "common",
        "supportsReadOnly": true
      }
    }
  ]
}
