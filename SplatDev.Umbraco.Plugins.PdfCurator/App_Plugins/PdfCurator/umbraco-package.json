{
  "$schema": "../../umbraco-package-schema.json",
  "id": "PdfCurator",
  "name": "Book Library",
  "version": "2.0.0",
  "allowPublicAccess": false,
  "extensions": [
    {
      "type": "section",
      "alias": "PdfCurator.Section",
      "name": "Book Library",
      "meta": {
        "label": "#pdfCurator_sectionLabel",
        "pathname": "pdf-curator"
      }
    },
    {
      "type": "sectionView",
      "alias": "PdfCurator.SectionView.Dashboard",
      "name": "Dashboard",
      "element": "/App_Plugins/PdfCurator/dist/pdfc-dashboard-wrapper.element.js",
      "elementName": "pdfc-dashboard-wrapper",
      "weight": 10,
      "meta": {
        "label": "#pdfCurator_dashboardLabel",
        "pathname": "dashboard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "PdfCurator.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "PdfCurator.SectionView.Library",
      "name": "Library",
      "element": "/App_Plugins/PdfCurator/dist/pdfc-library-wrapper.element.js",
      "elementName": "pdfc-library-wrapper",
      "weight": 20,
      "meta": {
        "label": "#pdfCurator_libraryLabel",
        "pathname": "library"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "PdfCurator.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "PdfCurator.SectionView.Review",
      "name": "Review",
      "element": "/App_Plugins/PdfCurator/dist/pdfc-review-wrapper.element.js",
      "elementName": "pdfc-review-wrapper",
      "weight": 30,
      "meta": {
        "label": "#pdfCurator_reviewLabel",
        "pathname": "review"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "PdfCurator.Section"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "PdfCurator.SectionView.Reports",
      "name": "Reports",
      "element": "/App_Plugins/PdfCurator/dist/pdfc-reports-wrapper.element.js",
      "elementName": "pdfc-reports-wrapper",
      "weight": 40,
      "meta": {
        "label": "#pdfCurator_reportsLabel",
        "pathname": "reports"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "PdfCurator.Section"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "PdfCurator.Localization.En",
      "name": "Book Library — English",
      "meta": {
        "culture": "en",
        "localizations": {
          "pdfCurator": {
            "sectionLabel": "Book Library",
            "dashboardLabel": "Dashboard",
            "libraryLabel": "Library",
            "reviewLabel": "Review",
            "reportsLabel": "Reports",
            "heading": "Book Library",
            "description": "Manage your digital book and PDF library",
            "upload": "Upload PDF",
            "comingSoon": "Coming soon — Phase B will integrate the full PDF Curator component suite."
          }
        }
      }
    },
    {
      "type": "localization",
      "alias": "PdfCurator.Localization.Es",
      "name": "Book Library — Español",
      "meta": {
        "culture": "es",
        "localizations": {
          "pdfCurator": {
            "sectionLabel": "Biblioteca",
            "dashboardLabel": "Panel",
            "libraryLabel": "Biblioteca",
            "reviewLabel": "Revisión",
            "reportsLabel": "Informes",
            "heading": "Biblioteca",
            "description": "Administre su biblioteca digital de libros y PDFs",
            "upload": "Subir PDF",
            "comingSoon": "Próximamente — La Fase B integrará el conjunto completo de componentes PDF Curator."
          }
        }
      }
    }
  ]
}