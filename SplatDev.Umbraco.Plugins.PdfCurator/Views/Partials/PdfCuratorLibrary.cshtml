@using System.Web
@{
    var isLoggedIn = Context.User?.Identity?.IsAuthenticated == true;
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (lang != "en" && lang != "es") { lang = "en"; }
}

<div class="pdfc-member-area">
    @if (!isLoggedIn)
    {
        <div class="pdfc-login-prompt">
            <h2>Member Library</h2>
            <p>Please log in to access the PDF library.</p>
            <a href="/login?returnUrl=@HttpUtility.UrlEncode(Context.Request.Path)" class="pdfc-login-btn">Log In</a>
        </div>
    }
    else
    {
        <nav class="pdfc-nav" aria-label="Library navigation">
            <a href="#library" class="pdfc-nav-link" data-route="library">Library</a>
            <a href="#favorites" class="pdfc-nav-link" data-route="favorites">Favorites</a>
        </nav>

        <div id="pdfc-app" data-lang="@lang"></div>
    }
</div>

<script type="module">
    import("/App_Plugins/PdfCurator/dist-member/member.js");
</script>

<style>
    .pdfc-member-area {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .pdfc-login-prompt {
        text-align: center;
        padding: 4rem 1.5rem;
        background: #f9fafb;
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
    }

    .pdfc-login-prompt h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: #111827;
    }

    .pdfc-login-prompt p {
        color: #6b7280;
        margin: 0 0 1.5rem;
    }

    .pdfc-login-btn {
        display: inline-block;
        padding: 0.625rem 1.5rem;
        background: #2563eb;
        color: #fff;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
        transition: background 0.15s;
    }

    .pdfc-login-btn:hover {
        background: #1d4ed8;
    }

    .pdfc-nav {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 0.75rem;
    }

    .pdfc-nav-link {
        padding: 0.5rem 1rem;
        color: #374151;
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        border-radius: 0.375rem;
        transition: background 0.15s, color 0.15s;
    }

    .pdfc-nav-link:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .pdfc-nav-link.active {
        background: #2563eb;
        color: #fff;
    }
</style>
