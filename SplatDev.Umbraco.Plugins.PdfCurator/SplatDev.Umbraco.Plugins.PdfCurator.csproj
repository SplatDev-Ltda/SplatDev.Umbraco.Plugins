<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <ContentTargetFolders>.</ContentTargetFolders>
    <PackageIcon>icon.png</PackageIcon>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0</FileVersion>
		<PackageId>SplatDev.Umbraco.Plugins.PdfCurator</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>2.1.4</Version>
		<Authors>SplatDev</Authors>
		<Description>Umbraco PDF curator/manager plugin supporting Umbraco 13 (net8.0) and Umbraco 17 (net10.0)</Description>
		<PackageTags>umbraco umbraco-marketplace</PackageTags>
		<Company>SplatDev Ltda</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</PackageProjectUrl>
		<RepositoryUrl>https://github.com/splatdevtech/SplatDev.Umbraco.Plugins</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
		<PackageReference Include="Umbraco.Cms.Core" Version="13.12.0" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="13.12.0" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.12.0" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="13.12.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.6" />
		<PackageReference Include="Umbraco.Cms.Core" Version="17.3.4" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.3.4" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="17.3.4" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="PdfCurator.Core" Version="0.2.38" />
		<PackageReference Include="PdfCurator.Web" Version="0.2.38" />
	</ItemGroup>

	<!-- The member area depends on PdfCurator.Core/Web (net10.0-only) — Umbraco 17 hosts only -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<Compile Remove="Controllers\Member\**\*.cs" />
		<Compile Remove="Components\PdfCuratorDatabaseHandler.cs" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

	<ItemGroup>
		<Content Remove="client\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="App_Plugins\**\*" />
		<None Include="Views\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>


  <!-- Pack backoffice assets at their App_Plugins paths; embedded resources alone are not deployed by PackageReference. -->
  <ItemGroup>
    <Content Include="App_Plugins\**\*" Pack="true" PackagePath="App_Plugins" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
