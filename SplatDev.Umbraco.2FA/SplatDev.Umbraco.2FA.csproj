<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<RootNamespace>SplatDev.Umbraco._2FA</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>SplatDev.Umbraco.2FA</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>2.0.2</Version>
		<Authors>SplatDev</Authors>
		<Description>Two-factor authentication utilities for Umbraco 13 (net8.0) and Umbraco 17 (net10.0)</Description>
		<PackageTags>umbraco umbraco-marketplace 2fa</PackageTags>
		<Company>SplatDev Ltda</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/SplatDev-Ltda/SplatDev.Umbraco.Plugins</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SplatDev-Ltda/SplatDev.Umbraco.Plugins</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
